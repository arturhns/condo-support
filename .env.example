# E-mail:
# Sem EMAIL_API_KEY → console (aparece no log do container).
# - EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Com EMAIL_API_KEY → Anymail:
# - Resend: EMAIL_BACKEND=anymail.backends.resend.EmailBackend
# - SendGrid: EMAIL_BACKEND=anymail.backends.sendgrid.EmailBackend
EMAIL_API_KEY=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=CondoAgenda <nao-responda@example.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
