SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web

POSTGRES_DB=condoagenda
POSTGRES_USER=condo
POSTGRES_PASSWORD=condo
POSTGRES_HOST=db
POSTGRES_PORT=5432

# E-mail:
# Sem EMAIL_API_KEY → console (aparece no log do container).
# - EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Com EMAIL_API_KEY → Anymail:
# - Resend: EMAIL_BACKEND=anymail.backends.resend.EmailBackend
# - SendGrid: EMAIL_BACKEND=anymail.backends.sendgrid.EmailBackend
EMAIL_API_KEY=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=CondoAgenda <nao-responda@example.com>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True

# --- Produção (nuvem / Render) — descomente e preencha no painel da plataforma ---
# DEBUG=0
# ALLOWED_HOSTS=condoagenda.onrender.com
# CSRF_TRUSTED_ORIGINS=https://condoagenda.onrender.com
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# EMAIL_API_KEY=
# DEFAULT_FROM_EMAIL=CondoAgenda <nao-responda@seudominio.com>
